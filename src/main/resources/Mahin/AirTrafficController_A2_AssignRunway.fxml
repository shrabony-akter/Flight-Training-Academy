<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Mahin.AirTrafficController_A2_AssignRunwayController">

    <children>

        <VBox spacing="15"
              alignment="CENTER"
              AnchorPane.topAnchor="30.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0">


            <Label text="Assign Runway For Training Flight"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>


            <TextField fx:id="flightIdField"
                       promptText="Flight ID"/>


            <ComboBox fx:id="runwayComboBox"
                      promptText="Select Runway"/>


            <Button text="Assign Runway"
                    onAction="#assignRunway"/>


            <Button text="Back"
                    onAction="#goBack"/>


        </VBox>

    </children>

</AnchorPane>