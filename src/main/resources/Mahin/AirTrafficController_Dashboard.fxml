<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="airTrafficControllerDashboardBorderpane"
            prefHeight="551.0"
            prefWidth="915.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Mahin.AirTrafficController_DashboardController">

    <top>
        <MenuBar>
            <menus>
                <Menu text="File">
                    <items>
                        <MenuItem text="Open File"/>
                        <MenuItem text="Close"/>
                    </items>
                </Menu>

                <Menu text="Help">
                    <items>
                        <MenuItem text="About"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>


    <left>

        <VBox spacing="10"
              prefWidth="220"
              style="-fx-background-color: ass;">

            <children>

                <Button text="View Flight Schedule"
                        onAction="#viewFlightScheduleButton"/>

                <Button text="Assign Runway For Training Flight"
                        onAction="#assignRunwayButton"/>

                <Button text="Monitor Active Flight Status"
                        onAction="#monitorActiveFlightStatusButton"/>

                <Button text="Approve Takeoff Request"
                        onAction="#approveTakeoffRequestButton"/>

                <Button text="Approve Landing Request"
                        onAction="#approveLandingRequestButton"/>

                <Button text="Generate Air Traffic Report"
                        onAction="#generateAirTrafficReportButton"/>

                <Button text="Logout"
                        onAction="#logoutButton"/>

            </children>

        </VBox>

    </left>


    <center>
        <AnchorPane/>
    </center>

</BorderPane>