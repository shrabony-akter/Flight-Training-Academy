<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Mahin.GroundInstructor_G6_SubmitGroundTrainingReportController">

    <children>

        <VBox spacing="15"
              alignment="CENTER"
              AnchorPane.topAnchor="20.0"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Submit Ground Training Report"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <TextField fx:id="instructorNameField"
                       promptText="Instructor Name"/>

            <TextField fx:id="reportTitleField"
                       promptText="Report Title"/>

            <DatePicker fx:id="reportDatePicker"
                        promptText="Report Date"/>

            <TextArea fx:id="trainingSummaryArea"
                      promptText="Training Summary"
                      prefHeight="100"/>

            <TextArea fx:id="studentProgressArea"
                      promptText="Student Progress"
                      prefHeight="100"/>

            <TextArea fx:id="remarksArea"
                      promptText="Remarks"
                      prefHeight="100"/>

            <Button text="Submit Report"
                    fx:id="submitReportButton"
                    onAction="#submitReport"/>

            <Button text="Back"
                    onAction="#goBack"/>

        </VBox>

    </children>

</AnchorPane>