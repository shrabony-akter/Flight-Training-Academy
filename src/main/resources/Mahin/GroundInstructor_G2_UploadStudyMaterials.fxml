<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Mahin.GroundInstructor_G2_UploadStudyMaterialsController">

    <children>

        <VBox spacing="15"
              alignment="CENTER"
              AnchorPane.topAnchor="20.0"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Upload Study Materials"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <TextField fx:id="materialTitleField"
                       promptText="Material Title"/>

            <TextField fx:id="subjectField"
                       promptText="Subject / Topic"/>

            <TextArea fx:id="descriptionArea"
                      promptText="Material Description"
                      prefHeight="100"/>

            <Button text="Choose File"
                    fx:id="chooseFileButton"
                    onAction="#chooseFile"/>

            <Label fx:id="fileNameLabel"
                   text="No file selected"/>

            <Button text="Upload Material"
                    fx:id="uploadButton"
                    onAction="#uploadMaterial"/>

            <Button text="Back"
                    onAction="#goBack"/>

        </VBox>

    </children>

</AnchorPane>