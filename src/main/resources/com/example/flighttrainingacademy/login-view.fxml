   <children>
      <ComboBox fx:id="userNameComboBox" layoutX="214.0" layoutY="71.0" prefWidth="150.0" promptText="User Name" />
      <Button layoutX="258.0" layoutY="187.0" mnemonicParsing="false" onAction="#logInButton" text="Log In" />
      <PasswordField fx:id="passwordPasswordField" layoutX="209.0" layoutY="123.0" text="Password" />
      <Text layoutX="141.0" layoutY="140.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Password" />
   </children>
</AnchorPane>
